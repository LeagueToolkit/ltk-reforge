{
  "$schema": "https://inlang.com/schema/inlang-message-format",
  "repair_archive_filter_label": "Mod archives",
  "repair_findings_empty": "Nothing to report",
  "repair_findings_title": "Findings",
  "repair_mod_by_label": "by {author}",
  "repair_mod_choose_action": "Choose mod",
  "repair_mod_drop_label": "Drop the mod here",
  "repair_mod_none": "No mod chosen. Choose one, or drop a .fantome or .zip on the window.",
  "repair_mod_skins_label": "skins {slots}",
  "repair_mod_thumbnail_alt": "The package's thumbnail, made from the mod's image",
  "repair_mod_title": "Mod",
  "repair_mod_version_label": "version {version}",
  "repair_mode_advanced_label": "Advanced",
  "repair_mode_guided_label": "Guided",
  "repair_mode_label": "View",
  "repair_mode_simple_label": "Simple",
  "repair_notes_hide_action": "Hide notes",
  "repair_notes_show_action": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "Show {count} note",
        "countPlural=other": "Show {count} notes"
      }
    }
  ],
  "repair_out_beside_label": "Written beside the mod",
  "repair_out_folder_label": "Written to {folder}",
  "repair_status_cancelled_description": "Nothing was written, and the run is not kept.",
  "repair_status_cancelled_title": "Stopped in {stage}",
  "repair_status_fault_title": "The run stopped: an input did not answer",
  "repair_status_halted_title": "No package: {message}",
  "repair_status_refused_description": "Each error is listed below. A package written anyway holds what each one says it loses.",
  "repair_status_refused_title": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "Not written: the run found {count} error",
        "countPlural=other": "Not written: the run found {count} errors"
      }
    }
  ],
  "repair_status_stopped_title": "Ran through {stage}",
  "repair_status_written_title": "Written",
  "repair_status_unkept": "The run was not kept: the store of runs cannot be read.",
  "repair_summary_counts_label": "{errors}, {warnings}, {notes}",
  "repair_summary_errors": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} error",
        "countPlural=other": "{count} errors"
      }
    }
  ],
  "repair_summary_notes": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} note",
        "countPlural=other": "{count} notes"
      }
    }
  ],
  "repair_summary_time_label": "in {seconds} s",
  "repair_summary_warnings": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} warning",
        "countPlural=other": "{count} warnings"
      }
    }
  ],
  "repair_write_anyway_action": "Write anyway",
  "repair_written_show_action": "Show in folder"
}

{
  "name": "reforge-app",
  "private": true,
  "license": "GPL-3.0-or-later",
  "version": "0.1.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm generate:messages && tsc && vite build",
    "preview": "vite preview",
    "tauri": "node scripts/tauri.mjs",
    "typecheck": "pnpm generate:messages && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:cycles": "oxlint --tsconfig tsconfig.json src",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm generate:messages && pnpm run --parallel \"/^(typecheck|lint|lint:cycles|format:check)$/\" && pnpm run test",
    "generate:messages": "paraglide-js compile --project ./project.inlang",
    "generate:types": "cargo test -p reforge-app --test bindings -- --ignored write_bindings"
  },
  "dependencies": {
    "@base-ui/react": "1.2.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@inlang/paraglide-js": "2.25.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.100.1",
    "@tanstack/react-router": "^1.168.23",
    "@tauri-apps/api": "~2.11.0",
    "@tauri-apps/plugin-dialog": "~2.7.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwind-merge": "^3.5.0",
    "ts-pattern": "^5.9.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@inlang/plugin-message-format": "4.4.4",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/eslint-plugin-query": "^5.102.8",
    "@tanstack/router-plugin": "^1.167.23",
    "@tauri-apps/cli": "~2.11.0",
    "@types/node": "^22.19.17",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.5.0",
    "oxc-transform-react": "^0.145.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@11.13.0"
}

{
  "$schema": "https://inlang.com/schema/project-settings",
  "baseLocale": "en",
  "locales": ["en"],
  "modules": ["./node_modules/@inlang/plugin-message-format/dist/index.js"],
  "plugin.inlang.messageFormat": {
    "pathPattern": [
      "./messages/{locale}/advanced.json",
      "./messages/{locale}/batch.json",
      "./messages/{locale}/bin.json",
      "./messages/{locale}/changes.json",
      "./messages/{locale}/decide.json",
      "./messages/{locale}/errors.json",
      "./messages/{locale}/findings.json",
      "./messages/{locale}/fixups.json",
      "./messages/{locale}/gate.json",
      "./messages/{locale}/guided.json",
      "./messages/{locale}/history.json",
      "./messages/{locale}/inputs.json",
      "./messages/{locale}/manager.json",
      "./messages/{locale}/mod.json",
      "./messages/{locale}/policy.json",
      "./messages/{locale}/records.json",
      "./messages/{locale}/repair.json",
      "./messages/{locale}/rules.json",
      "./messages/{locale}/run.json",
      "./messages/{locale}/runs.json",
      "./messages/{locale}/settings.json",
      "./messages/{locale}/shell.json",
      "./messages/{locale}/stages.json",
      "./messages/{locale}/common.json"
    ]
  }
}
